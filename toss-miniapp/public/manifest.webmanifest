      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "lang": "ko",
  "dir": "ltr",
  "scope": "./",
  "orientation": "portrait-primary",
  "categories": [
    "travel",
    "productivity",
    "lifestyle"
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "shortcuts": [
    {
      "name": "새 여행 만들기",
